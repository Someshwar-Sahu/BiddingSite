{
  "name": "biddingsite",
  "version": "1.0.0",
  "description": "A specialized, low-latency B2B e-auction platform modeled after industrial procurement platforms (such as Prime Trade Auctions). It enables corporate buyers to host scheduled reverse auctions for bulk commodities, industrial materials, and equipment, allowing vetted vendors to compete in real-time down to the lowest bid.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Someshwar-Sahu/BiddingSite.git"
  },
