{
  "name": "biddingsite",
  "version": "1.0.0",
  "description": "NexTrade Auctions: A specialized, low-latency B2B reverse e-auction platform for industrial procurement. It enables corporate buyers to host scheduled reverse auctions for bulk commodities, industrial materials, and equipment, allowing vetted vendors to compete in real-time down to the lowest bid.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:client": "vite",
    "build": "tsc",
    "build:client": "vite build",
    "build:all": "tsc && vite build",
    "seed:live": "tsx scripts/seed-live-auction.ts",
    "seed:waiting": "tsx scripts/seed-waiting-room.ts",
    "seed:sniping": "tsx scripts/seed-sniping.ts",
    "seed:clean": "tsx scripts/clean-test-auctions.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Someshwar-Sahu/BiddingSite.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Someshwar-Sahu/BiddingSite/issues"
  },
  "homepage": "https://github.com/Someshwar-Sahu/BiddingSite#readme",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "socket.io": "^4.8.4"
  }
}
