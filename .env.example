# ============================================================
# NEXTRADE AUCTIONS — ENVIRONMENT CONFIGURATION (.env)
# ============================================================

# 1. Server Port & Public Domain URL
# In local development: http://localhost:3000
# On Railway/Production: https://your-project.up.railway.app
PORT=3000
APP_BASE_URL=http://localhost:3000

# 2. SQLite Database File Location
# In local development: ./auction.db
# On Railway with persistent volume mounted to /data: /data/auction.db
DATABASE_PATH=./auction.db

# 3. Transactional Email Dispatcher (Resend)
# Sign up free (no card required) at https://resend.com to get your API key (3,000 free emails/month)
# Leave blank to run in Offline Simulator Mode (prints email action links directly to terminal)
RESEND_API_KEY=

# 4. Verified Sender Address
# For free Resend testing without custom domain: onboarding@resend.dev
# In production with verified domain: procurement@yourcompany.com
EMAIL_FROM=NexTrade Auctions <onboarding@resend.dev>

# 5. Environment
NODE_ENV=development

